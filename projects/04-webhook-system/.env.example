# Copy to .env and adjust as needed. Never commit a real .env file.
# Per-customer signing secrets are generated at runtime (see /subscriptions)
# and stored in the database, not here -- this is only the secret used to
# verify the *inbound* third-party sender in this demo.

DATABASE_URL=sqlite+aiosqlite:///./webhooks.db
INBOUND_SIGNING_SECRET=change-me-shared-secret-with-the-simulated-sender
REPLAY_WINDOW_SECONDS=300
MAX_DELIVERY_ATTEMPTS=8
DELIVERY_TIMEOUT_SECONDS=5
SECRET_ROTATION_GRACE_MINUTES=60
BASE_BACKOFF_SECONDS=2
