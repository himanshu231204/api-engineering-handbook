# Copy to .env and adjust as needed. Never commit a real .env file.
# In production, load JWT_SECRET_KEY from a secrets manager, not this file.

DATABASE_URL=sqlite+aiosqlite:///./auth.db
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=3
