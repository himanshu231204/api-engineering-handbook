# Copy this file to `.env` and fill in real values to use a real embedding
# model and LLM provider. Without these set, the example uses a local
# bag-of-words embedding fallback and a simple extractive "answer" fallback,
# so it still runs end-to-end with zero external credentials.

# Embedding provider (used by vector_store.py's embed()).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=example-embedding-v1

# Chat completion provider (used by main.py's call_llm()).
LLM_API_KEY=
LLM_MODEL=example-model-v1
