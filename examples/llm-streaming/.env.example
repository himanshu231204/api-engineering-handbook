# Copy this file to `.env` and fill in real values to stream from a real
# provider. Without these set, llm_client.py falls back to a local
# simulated stream so the example still runs end-to-end.

# API key for your chosen LLM provider (Anthropic, OpenAI, or any
# OpenAI/Anthropic-compatible chat completion API). Never commit a real key.
LLM_API_KEY=

# Model identifier to request from that provider.
LLM_MODEL=example-model-v1
