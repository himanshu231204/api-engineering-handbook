# Copy this file to `.env` and fill in real values to run the agent
# against a real LLM provider. Without these set, llm_client.py falls back
# to a small rule-based local simulation so the agent loop still runs
# end-to-end with zero external credentials.

# API key for your chosen LLM provider (Anthropic, OpenAI, or any
# OpenAI/Anthropic-compatible tool-calling chat completion API). Never
# commit a real key.
LLM_API_KEY=

# Model identifier to request from that provider.
LLM_MODEL=example-model-v1
