# Copy this file to `.env` and fill in real values to route to real
# providers. Without these set, providers.py simulates responses locally,
# so the gateway (routing, fallback, rate limiting, cost tracking) still
# runs end-to-end with zero external credentials.

# API key for "Provider A" (illustrative — an Anthropic-style API).
PROVIDER_A_API_KEY=

# API key for "Provider B" (illustrative — an OpenAI-compatible API).
PROVIDER_B_API_KEY=

# Fraction (0.0-1.0) of requests the credential-free test adapter should
# simulate as failed, to exercise the fallback path. Defaults to 0.5.
FLAKY_PROVIDER_FAILURE_RATE=0.5
