# Copy this file to .env and set a real secret before deploying anywhere
# beyond your own machine. Never commit a real .env. The same secret must
# be set for both receiver.py and sender.py.

WEBHOOK_SECRET=dev-secret-change-me

# receiver.py
REPLAY_TOLERANCE_SECONDS=300

# sender.py
WEBHOOK_URL=http://127.0.0.1:8000/webhooks/incoming
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_DELAY_SECONDS=0.5
WEBHOOK_MAX_DELAY_SECONDS=10
