# Copy this file to .env and adjust as needed. Never commit a real .env.

APP_NAME="FastAPI CRUD Example"
APP_VERSION=1.0.0
DEBUG=true

# SQLite by default -- swap for a real Postgres URL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tasks
DATABASE_URL=sqlite:///./tasks.db

# Comma-separated list of allowed origins, or "*" for any (dev only).
CORS_ORIGINS=*

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
